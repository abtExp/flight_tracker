# RENAME THIS FILE TO .env AND FILL IN YOUR KEYS

# 1. Amadeus API (For Real Flight Data)
# Get keys from: https://developers.amadeus.com/my-apps
VITE_AMADEUS_CLIENT_ID=your_amadeus_client_id_here
VITE_AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# 2. Google Sign-In (For Gmail Import)
# Get Client ID from Firebase Console -> Project Settings -> General -> Web App
VITE_GOOGLE_CLIENT_ID=your_web_client_id_from_firebase_here
